# The headers public/.htaccess of the web app sets for Apache. index.html carries the Content-Security-Policy as a
# <meta> element. DDALAB_ADDRESS is :8080 (plain HTTP, enough for localhost) or a DNS name (HTTPS on 80 and 443).
{
	admin off
}

{$DDALAB_ADDRESS} {
	root * /srv
	encode zstd gzip
	file_server

	# The scripts (sw.js aside), style sheets and wasm module carry a content hash in their names.
	@hashed {
		path *.js *.css *.wasm
		not path /sw.js
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The page and the service worker must be asked for each time, or an update would not show.
	@fresh path / /index.html /sw.js
	header @fresh Cache-Control "no-cache"
	@hidden path /.*
	respond @hidden 404
}
