# For Apache userdir hosting (mod_mime, mod_headers); Vite copies this file to dist/.htaccess.
# A host that ignores it still runs the app: the engine loader compiles the wasm from its bytes when the MIME type
# is wrong, and no header is required.

AddType application/wasm .wasm

<IfModule mod_headers.c>
  # The Content-Security-Policy. Hosts the app may fetch from are the connect-src line: change it here when the app
  # reaches a new host (OpenNeuro: its GraphQL API on openneuro.org, dataset files on s3.amazonaws.com).
  Header always set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'wasm-unsafe-eval'; \
    connect-src 'self' https://openneuro.org https://s3.amazonaws.com; \
    worker-src 'self'; img-src 'self' blob: data:; style-src 'self'; \
    base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

  # Every script, style sheet and wasm module carries a content hash in its name; only index.html does not.
  <FilesMatch "\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
