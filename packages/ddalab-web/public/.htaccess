# For Apache userdir hosting; Vite copies this file to dist/.htaccess.
# The folder needs AllowOverride FileInfo (or All). With AllowOverride None Apache ignores this file and the app still
# runs: the engine loader compiles the wasm from its bytes when the MIME type is wrong, and no header is required.

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
</IfModule>

# The wasm module is 1.1 MB and compresses to a third. SetOutputFilter in a FilesMatch leaves the host's own
# compression of text types alone; a folder-level AddOutputFilterByType would replace the host's list for the folder.
<IfModule mod_deflate.c>
  <FilesMatch "\.wasm$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # The Content-Security-Policy. The connect-src line lists the hosts the app may fetch from. Change it here when the
  # app reaches a new host (OpenNeuro: its GraphQL API on openneuro.org, dataset files on s3.amazonaws.com).
  # The build copies this policy into index.html as a <meta> element, which is all GitHub Pages can apply. A <meta>
  # policy ignores frame-ancestors, report-uri and sandbox: keep them out of this line.
  Header always set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'wasm-unsafe-eval'; \
    connect-src 'self' https://openneuro.org https://s3.amazonaws.com; \
    worker-src 'self'; img-src 'self' blob: data:; style-src 'self'; \
    base-uri 'none'; form-action 'none'"

  # Each response carries one Cache-Control and no Expires. A server-wide expiry (mod_expires) would add its own
  # Expires date and a short max-age for HTML and CSS.
  Header unset Expires
  # Every script, style sheet and wasm module carries a content hash in its name; only index.html does not.
  <FilesMatch "\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html and the service worker carry no hash in their names: the browser must ask for them each time.
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
